# Config for this copy.
#
# DELIBERATELY EXCLUDED from the signed manifest: changing the port is a
# supported thing to do, and re-sealing for every deployment variation is not a
# workflow anyone would follow. Editing this file cannot make the app refuse to
# start, and it cannot make it start when something else has been changed.
#
# It cannot pin the network interface either. Nothing loads this file into
# process.env; it is read by ports.mjs, which parses port numbers only, and by
# the launcher, which parses MDV2_PORT by hand with the same rules. A COS_HOST
# line here would do nothing at all, which is why there is not one. Exactly two
# things decide the bind address: the real environment variable COS_HOST that the
# launcher sets to 127.0.0.1, and the code default compiled into the bundle,
# which this build also sets to 127.0.0.1 so that a launch which skips the
# launcher is loopback too.

MDV2_PORT=4740
